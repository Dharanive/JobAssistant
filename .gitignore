# .gitignore – naukri-assistant
# Never commit credentials or personal data

# Credentials
.env
storage_state.json

# DB and reports
*.db
*.csv
report_*.csv

# Debug screenshots
debug/
logs/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE files
.vscode/
.idea/
*.swp
